{
  "name": "k-love",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -p . && vite build",
    "preview": "vite preview --port 5173 --strictPort",
    "build:electron": "tsc -p . && cross-env ELECTRON=1 vite build",
    "electron": "npm run build:electron && electron .",
    "dist": "npm run build:electron && electron-builder --win --publish never",
    "release": "npm run build:electron && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/gowun-batang": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.1.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "recharts": "^3.11.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vite-plugin-pwa": "^2.0.0",
    "xlsx": "^0.18.5"
  },
  "allowScripts": {
    "electron-winstaller": false
  },
  "description": "K-Dramen sammeln, bewerten und OSTs hören",
  "main": "electron/main.cjs",
  "build": {
    "appId": "de.klove.app",
    "productName": "K-Love",
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "K-Love",
      "artifactName": "K-Love-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "deevilius",
      "repo": "k-love",
      "releaseType": "release"
    }
  },
  "author": "deevilius",
  "repository": {
    "type": "git",
    "url": "https://github.com/deevilius/k-love.git"
  }
}

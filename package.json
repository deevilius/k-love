{
  "name": "k-love",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p . && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --publish never",
    "changelog": "node scripts/changelog.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/gowun-batang": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "recharts": "^3.11.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
    "@electron/asar": "^4.3.4",
    "global-agent": "^4.1.8"
  },
  "allowScripts": {
    "electron-winstaller": false
  },
  "description": "K-Dramen sammeln, bewerten und OSTs hören",
  "main": "electron/main.cjs",
  "build": {
    "appId": "de.klove.app",
    "productName": "K-Love",
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "K-Love",
      "artifactName": "K-Love-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "deevilius",
      "repo": "k-love",
      "releaseType": "release"
    }
  },
  "author": "deevilius",
  "repository": {
    "type": "git",
    "url": "https://github.com/deevilius/k-love.git"
  }
}
